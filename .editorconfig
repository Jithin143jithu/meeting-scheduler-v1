root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.{json,xml}]
indent_size = 2
indent_style = space

[*.php]
indent_size = 4
indent_style = space

[Makefile]
indent_style = tab
